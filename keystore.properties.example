# Copy to keystore.properties (git-ignored) to sign release builds.
# Generate a keystore first, outside the repo, e.g.
#   keytool -genkeypair -v -keystore ~/juicebox-release.jks -alias juicebox \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=/home/you/juicebox-release.jks
storePassword=change-me
keyAlias=juicebox
keyPassword=change-me
